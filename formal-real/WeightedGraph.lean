import Mathlib.Data.Real.Basic
import Mathlib.Algebra.Order.BigOperators.Group.Finset
import Mathlib.Algebra.BigOperators.Ring.Finset
import Mathlib.Logic.Relation
import Mathlib.Tactic.Ring

/-!
Real finite weighted graph energy. Edges have explicit endpoints; parallel
edges and loops are allowed. Connectivity means a finite path of actual
positive-weight edges, not an assumption about a quadratic-form kernel.

For the circle-pattern application, the geometric differentiation that
identifies a Hessian with this form, positivity of its conductances, and
connectivity of the ordinary-face graph remain written inputs.
-/

namespace VolumeLogic.WeightedGraph
open scoped BigOperators

variable {V E : Type*}

/-- An undirected step along one actual edge, in either orientation. -/
def edgeStep (src dst : E → V) (u v : V) : Prop :=
  ∃ e, (src e = u ∧ dst e = v) ∨ (src e = v ∧ dst e = u)

/-- A step must use an edge of strictly positive weight. Zero-weight edges
cannot force equality of vertex values. -/
def positiveStep (src dst : E → V) (w : E → ℝ) (u v : V) : Prop :=
  ∃ e, 0 < w e ∧ ((src e = u ∧ dst e = v) ∨ (src e = v ∧ dst e = u))

/-- Finite paths in the positive support connect every pair of vertices.
`ReflTransGen` is generated by zero steps and by adjoining one edge step. -/
def connected (src dst : E → V) (w : E → ℝ) : Prop :=
  ∀ u v, Relation.ReflTransGen (positiveStep src dst w) u v

/-- Ordinary graph connectivity suffices when every edge weight is positive. -/
theorem connected_of_positive_weights (src dst : E → V) (w : E → ℝ)
    (paths : ∀ u v, Relation.ReflTransGen (edgeStep src dst) u v)
    (hw : ∀ e, 0 < w e) : connected src dst w := by
  intro u v
  have hs : edgeStep src dst ≤ positiveStep src dst w := by
    intro a b hab
    obtain ⟨e, he⟩ := hab
    exact ⟨e, hw e, he⟩
  exact Relation.ReflTransGen.mono hs u v (paths u v)

/-- The finite real energy, with each edge counted once in the supplied list
of edge labels. A loop has zero contribution. -/
noncomputable def energy [Fintype E] (src dst : E → V) (w : E → ℝ)
    (f : V → ℝ) : ℝ :=
  ∑ e, w e * (f (src e) - f (dst e)) ^ 2

/-- The associated symmetric bilinear form is constructed from the same
endpoints and weights. -/
noncomputable def form [Fintype E] (src dst : E → V) (w : E → ℝ)
    (f g : V → ℝ) : ℝ :=
  ∑ e, w e * (f (src e) - f (dst e)) * (g (src e) - g (dst e))

theorem energy_nonneg [Fintype E] (src dst : E → V) (w : E → ℝ)
    (hw : ∀ e, 0 ≤ w e) (f : V → ℝ) : 0 ≤ energy src dst w f := by
  apply Finset.sum_nonneg
  intro e _
  exact mul_nonneg (hw e) (sq_nonneg _)

theorem energy_constant [Fintype E] (src dst : E → V) (w : E → ℝ)
    (c : ℝ) : energy src dst w (fun _ => c) = 0 := by
  simp [energy]

/-- With nonnegative weights, zero energy is equivalent to equality across
every positive-weight edge. No conclusion is imposed across a zero edge. -/
theorem energy_eq_zero_iff [Fintype E] (src dst : E → V) (w : E → ℝ)
    (hw : ∀ e, 0 ≤ w e) (f : V → ℝ) :
    energy src dst w f = 0 ↔ ∀ e, 0 < w e → f (src e) = f (dst e) := by
  rw [energy, Finset.sum_eq_zero_iff_of_nonneg
    (fun e _ => mul_nonneg (hw e) (sq_nonneg _))]
  constructor
  · intro h e he
    have hterm := h e (Finset.mem_univ e)
    have hsquare : (f (src e) - f (dst e)) ^ 2 = 0 :=
      (mul_eq_zero.mp hterm).resolve_left (ne_of_gt he)
    exact sub_eq_zero.mp (sq_eq_zero_iff.mp hsquare)
  · intro h e _
    by_cases he : 0 < w e
    · simp [h e he]
    · have hz : w e = 0 := le_antisymm (le_of_not_gt he) (hw e)
      simp [hz]

theorem equal_of_positive_step (src dst : E → V) (w : E → ℝ)
    (f : V → ℝ) (hedges : ∀ e, 0 < w e → f (src e) = f (dst e))
    {u v : V} (step : positiveStep src dst w u v) : f u = f v := by
  obtain ⟨e, he, hdir⟩ := step
  rcases hdir with ⟨hs, ht⟩ | ⟨hs, ht⟩
  · simpa only [hs, ht] using hedges e he
  · simpa only [hs, ht] using (hedges e he).symm

/-- Equality propagates by induction on the actual finite edge path. -/
theorem equal_of_positive_path (src dst : E → V) (w : E → ℝ)
    (f : V → ℝ) (hedges : ∀ e, 0 < w e → f (src e) = f (dst e))
    {u v : V} (path : Relation.ReflTransGen (positiveStep src dst w) u v) :
    f u = f v := by
  induction path with
  | refl => rfl
  | tail _ step ih =>
    exact ih.trans (equal_of_positive_step src dst w f hedges step)

/-- The only zero-energy functions on a connected positive support are
constant functions. This is derived from the sum and path definitions. -/
theorem energy_eq_zero_iff_constant [Fintype E]
    (src dst : E → V) (w : E → ℝ) (hw : ∀ e, 0 ≤ w e)
    (hc : connected src dst w) (f : V → ℝ) :
    energy src dst w f = 0 ↔ ∀ u v, f u = f v := by
  constructor
  · intro hz u v
    exact equal_of_positive_path src dst w f
      ((energy_eq_zero_iff src dst w hw f).mp hz) (hc u v)
  · intro hf
    exact (energy_eq_zero_iff src dst w hw f).mpr (fun e _ => hf _ _)

/-- Fixing one vertex to zero removes the constant kernel. -/
theorem grounded_energy_eq_zero_iff [Fintype E]
    (src dst : E → V) (w : E → ℝ) (hw : ∀ e, 0 ≤ w e)
    (hc : connected src dst w) (root : V) (f : V → ℝ)
    (ground : f root = 0) : energy src dst w f = 0 ↔ f = 0 := by
  constructor
  · intro hz
    have hconst := (energy_eq_zero_iff_constant src dst w hw hc f).mp hz
    funext v
    exact (hconst v root).trans ground
  · intro hz
    subst f
    exact energy_constant src dst w 0

/-- A nonzero grounded real variation has strictly positive energy. -/
theorem grounded_energy_pos [Fintype E]
    (src dst : E → V) (w : E → ℝ) (hw : ∀ e, 0 ≤ w e)
    (hc : connected src dst w) (root : V) (f : V → ℝ)
    (ground : f root = 0) (nonzero : f ≠ 0) : 0 < energy src dst w f := by
  have hn : energy src dst w f ≠ 0 := fun hz =>
    nonzero ((grounded_energy_eq_zero_iff src dst w hw hc root f ground).mp hz)
  exact lt_of_le_of_ne (energy_nonneg src dst w hw f) (Ne.symm hn)

theorem energy_eq_form_self [Fintype E] (src dst : E → V) (w : E → ℝ)
    (f : V → ℝ) : energy src dst w f = form src dst w f f := by
  unfold energy form
  apply Finset.sum_congr rfl
  intro e _
  ring

theorem form_symm [Fintype E] (src dst : E → V) (w : E → ℝ)
    (f g : V → ℝ) : form src dst w f g = form src dst w g f := by
  unfold form
  apply Finset.sum_congr rfl
  intro e _
  ring

theorem form_add_left [Fintype E] (src dst : E → V) (w : E → ℝ)
    (f g h : V → ℝ) :
    form src dst w (fun v => f v + g v) h =
      form src dst w f h + form src dst w g h := by
  unfold form
  rw [← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro e _
  ring

theorem form_smul_left [Fintype E] (src dst : E → V) (w : E → ℝ)
    (c : ℝ) (f g : V → ℝ) :
    form src dst w (fun v => c * f v) g = c * form src dst w f g := by
  unfold form
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro e _
  ring

/-- Adding a constant does not change the energy; grounding is exactly a
choice of representative modulo this constant direction. -/
theorem energy_add_constant [Fintype E] (src dst : E → V) (w : E → ℝ)
    (f : V → ℝ) (c : ℝ) :
    energy src dst w (fun v => f v + c) = energy src dst w f := by
  unfold energy
  apply Finset.sum_congr rfl
  intro e _
  ring

/-- A signed edge incidence, with value zero for a loop at its vertex. -/
noncomputable def incidence (src dst : E → V) (e : E) (v : V) : ℝ := by
  classical
  exact (if src e = v then 1 else 0) - (if dst e = v then 1 else 0)

/-- The explicit weighted Laplacian entries, B-transpose times W times B.
The formula handles repeated edges and loops without extra conventions. -/
noncomputable def laplacian [Fintype E] (src dst : E → V) (w : E → ℝ)
    (u v : V) : ℝ :=
  ∑ e, w e * incidence src dst e u * incidence src dst e v

theorem incidence_pairing [Fintype V] (src dst : E → V) (e : E)
    (f : V → ℝ) :
    (∑ v, incidence src dst e v * f v) = f (src e) - f (dst e) := by
  classical
  simp [incidence, sub_mul, ite_mul, Finset.sum_sub_distrib]

theorem laplacian_symm [Fintype E] (src dst : E → V) (w : E → ℝ)
    (u v : V) : laplacian src dst w u v = laplacian src dst w v u := by
  unfold laplacian
  apply Finset.sum_congr rfl
  intro e _
  ring

/-- The constructed matrix form is exactly the edge bilinear form. -/
theorem laplacian_form [Fintype V] [Fintype E]
    (src dst : E → V) (w : E → ℝ) (f g : V → ℝ) :
    (∑ u, ∑ v, f u * laplacian src dst w u v * g v) = form src dst w f g := by
  classical
  unfold laplacian form
  simp_rw [Finset.mul_sum, Finset.sum_mul]
  calc
    _ = ∑ u, ∑ e, ∑ v,
        f u * (w e * incidence src dst e u * incidence src dst e v) * g v := by
      apply Finset.sum_congr rfl
      intro u _
      rw [Finset.sum_comm]
    _ = ∑ e, ∑ u, ∑ v,
        f u * (w e * incidence src dst e u * incidence src dst e v) * g v :=
      Finset.sum_comm
    _ = ∑ e, w e * (∑ u, incidence src dst e u * f u) *
        (∑ v, incidence src dst e v * g v) := by
      apply Finset.sum_congr rfl
      intro e _
      simp_rw [Finset.mul_sum, Finset.sum_mul]
      rw [Finset.sum_comm]
      apply Finset.sum_congr rfl
      intro u _
      apply Finset.sum_congr rfl
      intro v _
      ring
    _ = _ := by simp only [incidence_pairing]

theorem laplacian_quadratic [Fintype V] [Fintype E]
    (src dst : E → V) (w : E → ℝ) (f : V → ℝ) :
    (∑ u, ∑ v, f u * laplacian src dst w u v * f v) = energy src dst w f := by
  rw [laplacian_form, energy_eq_form_self]

/-- Strict positivity of the explicit Laplacian quadratic form on the
subspace with one grounded vertex. -/
theorem grounded_laplacian_pos [Fintype V] [Fintype E]
    (src dst : E → V) (w : E → ℝ) (hw : ∀ e, 0 ≤ w e)
    (hc : connected src dst w) (root : V) (f : V → ℝ)
    (ground : f root = 0) (nonzero : f ≠ 0) :
    0 < ∑ u, ∑ v, f u * laplacian src dst w u v * f v := by
  rw [laplacian_quadratic]
  exact grounded_energy_pos src dst w hw hc root f ground nonzero

end VolumeLogic.WeightedGraph
