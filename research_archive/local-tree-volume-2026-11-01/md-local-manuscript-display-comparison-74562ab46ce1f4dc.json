  },
  {
    "source": "actual_all_circle_vertexwise_geometry.md",
    "tag": "2",
    "present": false,
    "equal": false,
    "source_formula": "\n \\Psi_v(\\boldsymbol\\tau)+\\frac{i n_v}{2\\pi}\\tau_v=ic,\n \\qquad\n \\Psi(\\boldsymbol\\tau)=\\sum_{vw}\\psi(\\tau_v,\\tau_w),\n \\qquad 0\\le c\\le1.\n\\tag{2}\n",
    "tex_formula": null
  },
  {
    "source": "actual_all_circle_vertexwise_geometry.md",
    "tag": "3",
    "present": false,
    "equal": false,
    "source_formula": "\n \\operatorname{Im}\\tau_v(c)<0\\quad(0<c\\le1),\\qquad\n |\\tau_v(c)|\n \\le\\frac{2\\pi c}\n          {\\sqrt{d_v^2+n_v^2}-d_v/39000}.\n\\tag{3}\n",
    "tex_formula": null
  },
  {
    "source": "actual_all_circle_vertexwise_geometry.md",
    "tag": "4",
    "present": false,
    "equal": false,
    "source_formula": "\n U_v=-2\\pi\\Psi_v-i\\epsilon_v\\tau_v,\\qquad\n V_v=2i\\tau_v,\\qquad U_v+p_vV_v=-2\\pi ic.\n\\tag{4}\n",
    "tex_formula": null
  },
