  {
    "source": "actual_all_circle_vertexwise_geometry.md",
    "tag": "1",
    "present": false,
    "equal": false,
    "source_formula": "\n                 \\sqrt{d_v^2+n_v^2}\\ \\ge630\n                    \\qquad\\text{for every vertex }v.\n\\tag{1}\n",
